{
	"short_name": "NflxMultiSubs",
	"description": "Bilingual Subtitles for Netflix (fixed)",
	"version": "3.0.3.2",
	"name": "NflxMultiSubs Safari Local",
	"manifest_version": 2,
	"author": "Dan Chen, Gert Mertes",
	"permissions": [
		"storage",
		"https://www.netflix.com/*"
	],
	"background": {
		"scripts": [
			"service_worker.min.js"
		]
	},
	"browser_action": {
		"default_icon": "icon-gray.png",
		"default_popup": "settings.html"
	},
	"icons": {
		"16": "icon16.png",
		"32": "icon32.png",
		"128": "icon128.png",
		"512": "icon.png"
	},
	"content_scripts": [
		{
			"matches": [
				"https://www.netflix.com/*"
			],
			"js": [
				"content.min.js"
			],
			"run_at": "document_start"
		},
		{
			"matches": [
				"https://www.netflix.com/*"
			],
			"js": [
				"nflxmultisubs.min.js"
			],
			"run_at": "document_start",
			"world": "MAIN"
		}
	]
}